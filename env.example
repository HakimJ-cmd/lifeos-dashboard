# Database (PostgreSQL via Neon). Ambil dari Neon dashboard > Connection Details:
# - DATABASE_URL: connection string dengan "-pooler" di hostname (dipakai app sehari-hari)
# - DIRECT_URL:   connection string TANPA "-pooler" (dipakai khusus saat migrate)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# WAJIB DIISI: string acak minimal 32 karakter untuk menandatangani sesi JWT.
# Generate contoh: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Akun awal yang dibuat oleh `npm run seed`
SEED_EMAIL="you@example.com"
SEED_PASSWORD="ChangeMe123!"

# Integrasi GitHub (opsional). Isi setelah setup webhook di repo GitHub-mu —
# harus SAMA PERSIS dengan "Secret" yang kamu masukkan di halaman
# Settings > Webhooks repo tersebut. Generate contoh: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=""
